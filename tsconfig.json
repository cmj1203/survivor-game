{
	// 브라우저에서 차례로 불러오는 전역 스크립트(js/*.js)와 Bun 테스트를 같은 프로젝트로 묶는다. 모듈 변환·빌드 없음(noEmit)
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"strict": true,
		"allowJs": true,
		"checkJs": true,            // js/*.js 도 타입 검사 (bunx tsc -p tsconfig.json). 아래 둘은 주석 없는 JS 라 끔 (켜면 오류 1,700개)
		"noImplicitAny": false,
		"strictNullChecks": false,
		"noEmit": true
	},
	"include": ["js/**/*.js", "tests/**/*.ts"]
}
